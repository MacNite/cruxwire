# Copy this file to .env and adjust for your environment.
# .env is gitignored - nothing environment-specific is ever committed.

# ── Ollama (LLM backend) ───────────────────────────────────────────────
# OLLAMA_HOST is the Ollama server URL. It is declared in docker-compose.yaml
# (environment:) - set it there, or override here; this .env value feeds the
# ${OLLAMA_HOST} interpolation in the compose file.
# Running Ollama on the same machine via Docker Desktop (Mac/Windows)? Inside the
# container `localhost` is the container -- use host.docker.internal instead:
#     OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434
# Which models to use is managed in the app at Settings → Models. These two
# only seed the INITIAL defaults on a fresh volume; the UI takes over after.
OLLAMA_MODEL=qwen3.5:4b
EMBED_MODEL=nomic-embed-text

# ── Clustering / ranking ───────────────────────────────────────────────
# Cosine similarity above which two articles are treated as the same story.
SIM_THRESHOLD=0.74
# Cross-source rank boost = min(BOOST_CAP, BOOST_K * log2(N sources)).
BOOST_CAP=1.5
BOOST_K=0.6

# ── Ingestion ──────────────────────────────────────────────────────────
LOOKBACK_HOURS=36
MAX_ARTICLES=1024
SCORE_CONCURRENCY=1
# CPU budget: at most this many never-seen articles are sent to the chat model
# per run (balanced across feeds); already-scored ones are reused for free.
# Benchmark with `python pipeline.py --benchmark 5` and adjust.
MAX_NEW_SCORED=40
# Process-wide cap on simultaneous Ollama requests (1 = one model job at a time).
OLLAMA_MAX_PARALLEL=1

# ── Schedule (reproduces the old cron: 0 6-22/2 * * *) ─────────────────
# TZ sets the timezone the active-hours window is measured in. Without it the
# container runs in UTC and runs fire in the wrong local window. Declared in
# docker-compose.yaml (defaults to America/Los_Angeles); override here.
TZ=Europe/Berlin
ACTIVE_START_HOUR=6
ACTIVE_END_HOUR=22
INTERVAL_HOURS=6
# Minute past the hour runs fire: 6 + every 6h + :30 → 06:30 morning briefing,
# then 12:30 and 18:30.
RUN_MINUTE=30

# ── Personalization (explicit likes / dislikes) ───────────────────────────
# Provisional starting points - all editable in Settings → Personalize.
FEEDBACK_LIKE_WEIGHT=1.5
FEEDBACK_DISLIKE_WEIGHT=1.0
FEEDBACK_CAP=2.0
SOURCE_AFFINITY_WEIGHT=0.5
EXPLORATION_SHARE=0.25
ONBOARDING_MIN_LIKES=10
ONBOARDING_RECOMMENDED_DISLIKES=3

# ── Network safety / embedding ────────────────────────────────────────────
# Allow fetching feeds/pages on private LAN addresses (default: refused).
ALLOW_PRIVATE_FETCH=false
# CORS for external integrations (comma-separated origins or *). Off by default.
CORS_ALLOW_ORIGIN=
# Restrict who may embed the app in an iframe, e.g. 'self' https://ha.example.lan
FRAME_ANCESTORS=

# ── User accounts ─────────────────────────────────────────────────────────
# none  = single user, no login (default; the trusted-network model)
# local = username/password accounts; each user gets private feeds,
#         categories, likes, history and their own digest. The first account
#         (setup page, or the two vars below) is the admin and owns the
#         existing data.
AUTH_MODE=none
# Optional: create the first admin on start instead of via the setup page.
# Only used while there are no accounts yet.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Session lifetime (sliding) in days.
SESSION_TTL_DAYS=30
# Mark the session cookie Secure: auto (when X-Forwarded-Proto is https),
# true or false. Behind an HTTPS reverse proxy, auto does the right thing.
COOKIE_SECURE=auto
# Lax (default) | Strict | None. Use None to embed the app in a Home Assistant
# dashboard served from another origin (requires HTTPS; the cookie is then Secure).
COOKIE_SAMESITE=lax
# Multi-user relevance: default weight of a user's category interests vs. the
# shared newsworthiness score (each user can change theirs in Personalize).
INTEREST_WEIGHT=0.5

# ── Single sign-on (OpenID Connect, e.g. authentik) ──────────────────────
# Works with AUTH_MODE=local (SSO offered next to passwords) or AUTH_MODE=oidc
# (SSO required; passwords become break-glass for admins). See README → SSO.
# Issuer = authentik's "OpenID Configuration Issuer" for the provider.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match a Redirect URI on the provider. Defaults to
# PUBLIC_URL + /auth/oidc/callback (or the request's host if PUBLIC_URL is unset).
PUBLIC_URL=
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid profile email
# Members of this group are admins; everyone else a plain user (synced at every
# SSO sign-in). Leave empty to manage roles in Settings → Users.
OIDC_ADMIN_GROUP=
# Create an account on first SSO sign-in (false = admins must link accounts).
OIDC_AUTO_CREATE=true
# Link a first SSO sign-in to an existing account: none | username | email
# (email only when the provider says it is verified).
OIDC_LINK_BY=none
OIDC_BUTTON_LABEL=Sign in with authentik
# Password sign-in: on | admins (break-glass) | off. Default: on for
# AUTH_MODE=local, admins for AUTH_MODE=oidc.
LOCAL_LOGIN=

# ── Server / data paths ────────────────────────────────────────────────
PORT=8090
# Host address compose publishes the port on. Default 127.0.0.1 (this machine
# only); 0.0.0.0 exposes it on every interface - prefer a TLS reverse proxy.
BIND_ADDR=127.0.0.1
# Container resource limits (compose).
#MEM_LIMIT=512m
#PIDS_LIMIT=256
#CPUS=2

# ── Load limits ────────────────────────────────────────────────────────
# Idle socket timeout and overall request-body deadline (seconds).
#REQUEST_TIMEOUT_S=30
#BODY_READ_DEADLINE_S=30
# Concurrent requests handled at once (503 beyond).
#MAX_CONCURRENT_REQUESTS=64
# Interactive model jobs (search, TL;DR) at once across users, and per-user
# per-minute limits for them (429 beyond).
#MAX_INTERACTIVE_MODEL_JOBS=8
#SEARCH_PER_MINUTE=30
#TLDR_PER_MINUTE=10
# Feed imports that validate feeds at the same time.
#MAX_CONCURRENT_IMPORTS=2
STATE_FILE=/data/state.json
DIGEST_FILE=/data/digest.json
FEEDS_FILE=/data/feeds.json
# Categories (labels/colors + the interest descriptions the scorer ranks
# against) live here - edit it to make the app about your own interests. Seeded
# from categories.sample.json on first run; falls back to built-in defaults.
CATEGORIES_FILE=/data/categories.json

# ── Retention ──────────────────────────────────────────────────────────
# History is auto-tracked and aged out after this many days. Read Later is a
# manually-curated list and is never aged out.
HISTORY_RETENTION_DAYS=3

# Inbox retention. Unread stories are carried forward across runs (so a story
# you never read doesn't vanish when its feed rotates it out) and pruned by a
# rank-weighted lifespan held inside a [floor, ceiling] band. Read stories are
# vacated; History keeps its own copy. Stories = de-duplicated clusters.
RETAIN_FLOOR=25                # keep at least this many unread stories if available
RETAIN_CEILING=60             # never carry more than this; lowest-ranked fall off
RETAIN_BASE_TTL_HOURS=24      # lifespan of the lowest-ranked story
RETAIN_MAX_TTL_HOURS=72       # lifespan of the highest-ranked story
RETAIN_HARD_MAX_AGE_HOURS=120 # absolute cutoff; overrides the floor

# ── Clustering Bench corpus capture (optional, off by default) ───────────
# When enabled, each run appends a copy of its retained, clustered articles
# (text + embedding + metadata) to an append-only JSONL archive on a shared
# volume, for the separate offline Clustering Bench. Best-effort and non-fatal:
# a failed write never affects the digest or the feed. Leave unset to disable.
BENCH_CAPTURE_ENABLED=false
# Shared volume path; mounted read-write here, read-only by the bench container.
BENCH_CORPUS_DIR=/shared/corpus
